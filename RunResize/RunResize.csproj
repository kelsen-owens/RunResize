<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RunResize</RootNamespace>
    <AssemblyName>RunResize</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only; Revit supplies the real API at runtime.
         Pinned to the first 2027 release: .NET won't load an add-in built against a newer RevitAPI than the installed one. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2027.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2027.0.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RunResize.addin" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Revit loads Debug builds through RunResize.DevHost (see the README), so building here needs no install step.
       Close Revit before building, since it locks the DLL. -->

</Project>
