<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(RevitTargetFramework)</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RunResize</RootNamespace>
    <AssemblyName>RunResize</AssemblyName>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Reference assemblies only; Revit supplies the real API at runtime. The year comes from Directory.Build.props: the
         add-in ships for 2027 only, and Debug builds for earlier years exist to run the test runner there.
         Pinned to each year's first release: .NET won't load an add-in built against a newer RevitAPI than the installed one. -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="$(RevitApiPackage)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="$(RevitApiPackage)" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Update="RunResize.addin" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Resources\*.png" />
  </ItemGroup>

  <!-- Revit loads Debug builds through RunResize.DevHost (see the README), so building here needs no install step.
       Close Revit before building, since it locks the DLL. -->

</Project>
